---
layout: base.njk
title: "Galerie — VisuVox"
permalink: /galerie/index.html
---
<header id="hdr" style="position:relative;">
  <a class="logo" href="/"><span class="logo-text">Visu<em>Vox</em></span></a>
  <div class="hdr-btns">
    <a href="/" class="btn btn-ghost">← Accueil</a>
  </div>
</header>

<section style="max-width:1100px;margin:0 auto;padding:160px 24px 100px;">
  <p style="color:var(--bleu);font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;">Galerie</p>
  <h1 style="font-family:'Fraunces',serif;font-size:clamp(28px,5vw,44px);color:var(--blanc);margin:10px 0 40px;">Nos activités et réalisations</h1>

  {% if collections.gallery.length %}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px;">
    {% for photo in collections.gallery %}
    <figure style="margin:0;">
      <img src="{{ photo.data.image }}" alt="{{ photo.data.title }}" style="width:100%;height:200px;object-fit:cover;border-radius:4px;display:block;">
      {% if photo.data.title %}
      <figcaption style="color:var(--gris-c);font-size:13px;margin-top:8px;">{{ photo.data.title }}</figcaption>
      {% endif %}
    </figure>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:var(--gris-c);">Aucune photo pour le moment — revenez bientôt !</p>
  {% endif %}
</section>
